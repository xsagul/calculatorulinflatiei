---
// Invelisul comun: head-ul, antetul, subsolul si datele structurate.
// Fiecare pagina isi da titlul, descrierea si calea; restul se compune aici, ca
// sa nu existe doua locuri care spun cine suntem.
import '@/styles/global.css';
import Logo from '@/components/Logo.astro';
import { SURSA, ULTIMA_LUNA, etichetaLuna, LUNI_DIN_COMUNICAT, SURSA_COMUNICAT } from '@/lib/inflatie';

interface Props {
  titlu: string;
  descriere: string;
  cale: string;
  /** Date structurate suplimentare, specifice paginii. */
  schema?: Record<string, unknown>;
}

const { titlu, descriere, cale, schema } = Astro.props;
const SITE = 'https://calculatorulinflatiei.ro';
// URL-urile se servesc cu slash la final; canonicul trebuie sa arate exact catre
// adresa livrata, nu catre una care redirecteaza.
const canonical = `${SITE}${cale === '/' ? '/' : cale.replace(/\/$/, '') + '/'}`;
const actualizat = etichetaLuna(ULTIMA_LUNA);

// Meniul apare pe fiecare pagina. Rata inflatiei sta imediat dupa calculator:
// e a doua intentie de cautare a subiectului.
const MENIU = [
  { href: '/', eticheta: 'Calculator inflație' },
  { href: '/rata-inflatiei/', eticheta: 'Rata inflației' },
  { href: '/salariu/', eticheta: 'Salariu net' },
  { href: '/tva/', eticheta: 'TVA' },
  { href: '/date/', eticheta: 'Date' },
];
const caleCurenta = Astro.url.pathname;
const activ = (href: string) => (href === '/' ? caleCurenta === '/' : caleCurenta.startsWith(href));

const GRUPURI = [
  {
    titlu: 'Calculatoare',
    linkuri: [
      { href: '/', eticheta: 'Calculator inflație' },
      { href: '/actualizare-cu-rata-inflatiei/', eticheta: 'Actualizare cu rata inflației' },
      { href: '/salariu/', eticheta: 'Calculator salariu net' },
      { href: '/tva/', eticheta: 'Calculator TVA' },
    ],
  },
  {
    titlu: 'Informații',
    linkuri: [
      { href: '/rata-inflatiei/', eticheta: 'Rata inflației, an de an' },
      { href: '/salariu-minim/', eticheta: 'Salariul minim' },
      { href: '/date/', eticheta: 'Datele, descărcabile' },
      { href: '/api/', eticheta: 'API public' },
      { href: '/incorporeaza/', eticheta: 'Pune-l pe site-ul tău' },
    ],
  },
  {
    titlu: 'Despre',
    linkuri: [
      { href: '/contact/', eticheta: 'Contact' },
      { href: '/politica-de-confidentialitate/', eticheta: 'Confidențialitate' },
      { href: '/cookies/', eticheta: 'Cookie-uri' },
    ],
  },
];

const schemaSite = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE}#site`,
      url: SITE,
      name: 'Calculatorul Inflației',
      inLanguage: 'ro-RO',
      description:
        'Cât valorează banii în România: puterea de cumpărare a leului pe indicele prețurilor de consum publicat de Institutul Național de Statistică, și salariul net după contribuții și impozit.',
    },
    {
      '@type': 'Dataset',
      '@id': `${SITE}#date`,
      name: 'Indicele prețurilor de consum, serie lunară',
      description: `Lanțul lunar al indicelui prețurilor de consum, ${SURSA.denumire}, din ianuarie 1991 până în ${actualizat}.`,
      license: 'https://data.gov.ro/base/images/logoinst/OGL-ROU-1.0.pdf',
      creator: { '@type': 'GovernmentOrganization', name: SURSA.institutie },
      isBasedOn: SURSA.url,
      temporalCoverage: `1991-01/${ULTIMA_LUNA.an}-${String(ULTIMA_LUNA.luna).padStart(2, '0')}`,
      variableMeasured: 'Indicele prețurilor de consum, față de luna precedentă',
    },
    ...(schema ? [schema] : []),
  ],
};
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titlu}</title>
    <meta name="description" content={descriere} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f8f5ef" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ro_RO" />
    <meta property="og:site_name" content="Calculatorul Inflației" />
    <meta property="og:title" content={titlu} />
    <meta property="og:description" content={descriere} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(schemaSite)} />
  </head>

  <body>
    <a href="#continut" class="sari">Sari la conținut</a>

    <header class="antet">
      <div class="antet-rand">
        <a href="/" class="marca" aria-label="Calculatorul Inflației, pagina principală">
          <Logo />
        </a>
        <nav aria-label="Principal" class="meniu">
          {MENIU.map((m) => (
            <a href={m.href} aria-current={activ(m.href) ? 'page' : undefined}>{m.eticheta}</a>
          ))}
        </nav>
      </div>
    </header>

    <main id="continut">
      <slot />
    </main>

    <footer class="subsol">
      <div class="invelis">
        <div class="subsol-sus">
          <a href="/" class="marca" aria-label="Calculatorul Inflației, pagina principală"><Logo /></a>
          <p>
            Cât valorează banii în România, pe indicele prețurilor de consum publicat de INS.
            Calculele au caracter orientativ.
          </p>
        </div>

        <div class="subsol-grupuri">
          {GRUPURI.map((g) => (
            <div>
              <p class="grup-titlu">{g.titlu}</p>
              <ul>
                {g.linkuri.map((l) => <li><a href={l.href}>{l.eticheta}</a></li>)}
              </ul>
            </div>
          ))}
        </div>

        <p class="sursa">
          Sursa cifrelor: {SURSA.institutie}, {SURSA.baza}, matricea {SURSA.matrice}. Serie lunară
          din ianuarie 1991, actualizată până în {actualizat}. Reutilizare conform licenței {SURSA.licenta}.
          {LUNI_DIN_COMUNICAT.length > 0 && (
            <>
              {' '}Ultima {LUNI_DIN_COMUNICAT.length === 1 ? 'lună' : `${LUNI_DIN_COMUNICAT.length} luni`}
              {' '}({LUNI_DIN_COMUNICAT.map((l) => etichetaLuna(l)).join(', ')}) {LUNI_DIN_COMUNICAT.length === 1 ? 'vine' : 'vin'} din
              {' '}<a href={SURSA_COMUNICAT.url} rel="noopener">comunicatul de presă</a> al institutului,
              care apare înaintea încărcării în baza de date.
            </>
          )}
        </p>
        <p class="sursa">
          Sumele dinainte de 1 iulie 2005 sunt în lei vechi (ROL). Conversia în lei noi aplică
          denominarea din Legea nr. 348/2004, adică împărțirea la 10.000.
        </p>
      </div>
    </footer>

    <style>
      .sari {
        position: absolute;
        left: -9999px;
        background: var(--hartie-sus);
        padding: var(--sp-2) var(--sp-4);
        z-index: 10;
      }
      .sari:focus { left: var(--sp-4); top: var(--sp-2); }

      /* Antetul: 64 px, linia punctata dedesubt, ca la salariile.ro. */
      .antet {
        background: var(--hartie) var(--punctat) left bottom / 100% 1px no-repeat;
      }
      .antet-rand {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        column-gap: var(--sp-6);
        padding-inline: var(--sp-4);
        min-height: 4rem;
      }
      @media (min-width: 40rem) { .antet-rand { padding-inline: var(--sp-6); } }
      .marca { display: inline-flex; align-items: center; min-height: 2.75rem; margin-right: auto; text-decoration: none; }

      /* Pe telefon, meniul coboara pe al doilea rand si se deruleaza lateral;
         pe ecran lat sta in dreapta, ca la salariile.ro. */
      .meniu {
        display: flex;
        gap: var(--sp-6);
        width: 100%;
        overflow-x: auto;
        scrollbar-width: none;
        font-size: 0.875rem;
        font-weight: 500;
      }
      .meniu::-webkit-scrollbar { display: none; }
      .meniu a {
        display: inline-flex;
        align-items: center;
        min-height: 2.75rem;
        white-space: nowrap;
        text-decoration: none;
        color: var(--cerneala-slaba);
        transition: color 0.1s;
      }
      .meniu a:hover, .meniu a[aria-current='page'] { color: var(--cerneala); }
      @media (min-width: 52rem) { .meniu { width: auto; overflow: visible; } }

      /* Subsolul: linia punctata deasupra, coloane de linkuri. */
      .subsol {
        margin-top: var(--sp-16);
        padding-block: var(--sp-8) var(--sp-6);
        background: var(--hartie) var(--punctat) left top / 100% 1px no-repeat;
        color: var(--cerneala-slaba);
      }
      @media (min-width: 40rem) { .subsol { padding-top: var(--sp-12); } }
      .subsol-sus {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--sp-4);
        padding-bottom: var(--sp-8);
        margin-bottom: var(--sp-8);
        border-bottom: 1px solid var(--linie);
      }
      .subsol-sus p { font-size: 0.875rem; max-width: 26rem; margin: 0; }
      @media (min-width: 40rem) {
        .subsol-sus { flex-direction: row; align-items: center; justify-content: space-between; }
      }
      .subsol-grupuri {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--sp-8);
        padding-bottom: var(--sp-8);
        margin-bottom: var(--sp-6);
        border-bottom: 1px solid var(--linie);
      }
      @media (min-width: 40rem) { .subsol-grupuri { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
      .grup-titlu { font-size: 0.75rem; font-weight: 500; margin: 0 0 var(--sp-2); }
      .subsol ul { list-style: none; margin: 0; padding: 0; }
      .subsol li a {
        display: flex;
        align-items: center;
        min-height: 2.75rem;
        font-size: 0.875rem;
        text-decoration: none;
        color: var(--cerneala-slaba);
      }
      .subsol li a:hover { color: var(--cerneala); }
      .subsol .sursa { font-size: 0.75rem; margin-bottom: var(--sp-2); }
    </style>
  </body>
</html>
