---
// Marca, din 16 noiembrie 2026: generata in ChatGPT, redesenata aici in vector
// ca sa ramana clara la orice marime. Simbolul — o bara inalta si una scurta —
// e suma de atunci si ce cumpara ea azi. Wordmarkul e text in Inter, nu
// imagine: se citeste, se cauta si nu se pixelizeaza.
interface Props { class?: string }
const { class: clasa = '' } = Astro.props;
---

<span class:list={['logo', clasa]}>
  <svg class="simbol" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <rect width="32" height="32" rx="7" fill="#efe6da" />
    <rect x="7.5" y="6.5" width="7.5" height="19" rx="1" fill="#1c1917" />
    <rect x="17" y="15" width="7.5" height="10.5" rx="1" fill="#c8553d" />
  </svg>
  <span class="cuvant">calculatorulinflatiei<span class="ro">.ro</span></span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.5rem; line-height: 1; }
  .simbol { width: 1.75rem; height: 1.75rem; flex: none; }
  .cuvant {
    font-family: var(--font-titlu);
    font-weight: 800;
    font-size: 1.0625rem;
    letter-spacing: -0.035em;
    color: #1c1917;
  }
  .ro { color: #8a857c; }
  @media (min-width: 40rem) {
    .simbol { width: 2rem; height: 2rem; }
    .cuvant { font-size: 1.1875rem; }
  }
</style>
