---
// Calculatorul principal.
//
// Pagina se randeaza pe server cu un rezultat real, nu cu un formular gol: cine
// ajunge aici dintr-o cautare vede un raspuns inainte sa atinga ceva, iar Google
// indexeaza cifre, nu un schelet. Scriptul preia apoi acelasi calcul in browser.
//
// AMBELE CAPETE SE ALEG. Prima versiune fixa data-tinta pe ultima luna cu date,
// ceea ce raspundea doar la jumatate din intrebari: „cat valorau 1.000 de lei din
// 2010 in 2015" nu se putea pune. Intervalul liber e ce ofera concurenta si ce
// cere subiectul.
//
// UN SINGUR RASPUNS MARE. Din 16 noiembrie 2026 rezultatul e un tabel, ca la
// salariile.ro: celelalte citiri (de cate ori au crescut preturile, puterea
// ramasa, media anuala) stau pe randuri mici, iar raspunsul — cat valoreaza suma
// in luna finala — e randul inversat de jos, cu cifra marcata.
import {
  converteste, ULTIMA_LUNA, PRIMA_LUNA, etichetaLuna, numeLuna, aniDisponibili, LANT_INDICI,
} from '@/lib/inflatie';
import date from '@/data/ipc-lunar.json';

interface Props {
  suma?: number;
  deLaAn?: number;
  deLaLuna?: number;
  panaLaAn?: number;
  panaLaLuna?: number;
}
const {
  suma = 1000,
  deLaAn = 2020,
  deLaLuna = 1,
  panaLaAn = ULTIMA_LUNA.an,
  panaLaLuna = ULTIMA_LUNA.luna,
} = Astro.props;

const de = { an: deLaAn, luna: deLaLuna };
const la = { an: panaLaAn, luna: panaLaLuna };
const r = converteste(suma, de, la);
const ani = aniDisponibili();

const lant = LANT_INDICI;
const config = { lant, primaLuna: PRIMA_LUNA, ultimaLuna: ULTIMA_LUNA, factorDenominare: date.denominare.factor };

const lei = (n: number, z = 2) =>
  n.toLocaleString('ro-RO', { minimumFractionDigits: z, maximumFractionDigits: z });
const crescut = r.factorPreturi >= 1;
---

<section class="calc" aria-label="Calculator inflație" data-config={JSON.stringify(config)}>
  <div class="card">
    <h2 class="card-titlu">Suma și perioada</h2>

    <form class="form" id="calc-form">
      <div class="camp">
        <label for="suma">Suma</label>
        <div class="grup">
          <input id="suma" type="number" inputmode="decimal" min="0" step="any" value={suma} required />
          <span class="unitate" id="u-intrare">{r.monedaDe}</span>
        </div>
      </div>

      <fieldset class="camp">
        <legend>Din</legend>
        <div class="luna-an">
          <select id="luna-de" aria-label="Luna de început">
            {Array.from({ length: 12 }, (_, i) => i + 1).map((m) => (
              <option value={m} selected={m === deLaLuna}>{numeLuna(m)}</option>
            ))}
          </select>
          <select id="an-de" aria-label="Anul de început">
            {ani.map((a) => <option value={a} selected={a === deLaAn}>{a}</option>)}
          </select>
        </div>
      </fieldset>

      <fieldset class="camp">
        <legend>Până în</legend>
        <div class="luna-an">
          <select id="luna-la" aria-label="Luna finală">
            {Array.from({ length: 12 }, (_, i) => i + 1).map((m) => (
              <option value={m} selected={m === panaLaLuna}>{numeLuna(m)}</option>
            ))}
          </select>
          <select id="an-la" aria-label="Anul final">
            {ani.map((a) => <option value={a} selected={a === panaLaAn}>{a}</option>)}
          </select>
        </div>
      </fieldset>

      <button type="submit">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <rect x="2.5" y="1.5" width="11" height="13" rx="1.5" stroke="currentColor" stroke-width="1.3" />
          <path d="M5 4.5h6M5 8h1.5M9.5 8H11M5 11h1.5M9.5 11H11" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
        </svg>
        Calculează
      </button>
    </form>
  </div>

  <div class="card">
    <h2 class="card-titlu">Rezultat</h2>

    <p class="eroare" id="eroare" hidden role="alert"></p>

    <output class="rezultat" for="suma luna-de an-de luna-la an-la">
      <table>
        <thead>
          <tr><th scope="col">Indicator</th><th scope="col" class="num">Valoare</th></tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">Suma, în <span id="e-atunci">{etichetaLuna(de)}</span></th>
            <td class="num cifre" id="r-atunci">{lei(suma)} {r.monedaDe}</td>
          </tr>
          <tr>
            <th scope="row" id="e-factor">{crescut ? 'Prețurile au crescut de' : 'Prețurile au scăzut cu'}</th>
            <td class="num cifre" id="r-factor">
              {crescut ? `${lei(r.factorPreturi, 2)} ori` : `${lei((1 - r.factorPreturi) * 100, 1)}%`}
            </td>
          </tr>
          <tr>
            <th scope="row">Inflație cumulată</th>
            <td class="num cifre" id="r-cumulata">{lei(r.inflatieCumulata, 1)}%</td>
          </tr>
          <tr>
            <th scope="row">Putere de cumpărare rămasă</th>
            <td class="num cifre" id="d-putere">{lei(r.putereRamasa, 1)}%</td>
          </tr>
          <tr>
            <th scope="row">Rata medie anuală</th>
            <td class="num cifre" id="d-medie">
              {r.rataMedieAnuala !== null ? `${lei(r.rataMedieAnuala, 1)}%` : 'sub un an'}
            </td>
          </tr>
          <tr class="total">
            <th scope="row">Valorează în <span id="e-acum">{etichetaLuna(la)}</span></th>
            <td class="num cifre"><span class="marcaj" id="r-acum">{lei(r.echivalent)} {r.monedaLa}</span></td>
          </tr>
        </tbody>
      </table>
    </output>

    <p class="denominare" id="r-denominare" hidden={!r.denominareAplicata}>
      Suma e în lei vechi. Conversia aplică denominarea din 1 iulie 2005, prin care 10.000 ROL au
      devenit 1 RON.
    </p>
    <p class="nota">
      Pe indicele prețurilor de consum publicat de INS, lună de lună, până în {etichetaLuna(ULTIMA_LUNA)}.
    </p>
  </div>
</section>

<style>
  .calc { display: grid; gap: var(--sp-4); align-items: start; }
  @media (min-width: 48rem) { .calc { grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: var(--sp-6); } }

  /* Titlurile cardurilor sunt h2 pentru structura paginii, dar arata ca etichete. */
  .card-titlu { margin-top: 0; }

  .form { display: flex; flex-direction: column; gap: var(--sp-4); }
  .luna-an { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: var(--sp-2); }

  .form button { display: inline-flex; align-items: center; justify-content: center; gap: var(--sp-2); width: 100%; margin-top: var(--sp-2); }

  .rezultat { display: block; border: 1px solid var(--linie-tare); border-radius: var(--raza-camp); overflow: hidden; }
  .rezultat table { width: 100%; border-collapse: collapse; }
  .rezultat th, .rezultat td { font-size: 0.875rem; }
  .rezultat tbody th { font-weight: 400; }
  .rezultat td { white-space: nowrap; }
  .rezultat thead th:first-child, .rezultat tbody th { border-right: 1px solid var(--linie-tare); }
  .rezultat tr.total > * { border-right-color: #44403c; }
  .rezultat tr.total th { font-weight: 600; }

  .eroare, .denominare {
    margin: 0 0 var(--sp-4);
    padding: var(--sp-3);
    border: 1px solid var(--linie-hover);
    border-left: 3px solid var(--cerneala);
    border-radius: var(--raza-camp);
    background: var(--hartie);
    font-size: 0.875rem;
    font-weight: 500;
  }
  .denominare { margin: var(--sp-4) 0 0; font-weight: 400; }
  .nota { margin: var(--sp-3) 0 0; font-size: 0.75rem; color: var(--cerneala-slaba); }
</style>

<script>
  // Acelasi calcul ca pe server, ca rezultatul sa nu difere intre randari.
  const sectiune = document.querySelector<HTMLElement>('.calc');
  const form = document.getElementById('calc-form') as HTMLFormElement | null;
  if (sectiune && form) {
    const cfg = JSON.parse(sectiune.dataset.config!) as {
      lant: number[];
      primaLuna: { an: number; luna: number };
      ultimaLuna: { an: number; luna: number };
      factorDenominare: number;
    };
    const LUNI = ['ianuarie', 'februarie', 'martie', 'aprilie', 'mai', 'iunie',
      'iulie', 'august', 'septembrie', 'octombrie', 'noiembrie', 'decembrie'];
    const rang = (an: number, luna: number) => an * 12 + (luna - 1);
    const rPrim = rang(cfg.primaLuna.an, cfg.primaLuna.luna);
    const rUltim = rang(cfg.ultimaLuna.an, cfg.ultimaLuna.luna);
    const rDenom = rang(2005, 7);
    const lei = (n: number, z = 2) =>
      n.toLocaleString('ro-RO', { minimumFractionDigits: z, maximumFractionDigits: z });
    const el = (id: string) => document.getElementById(id);
    const scrie = (id: string, t: string) => { const e = el(id); if (e) e.textContent = t; };
    const val = (id: string) => Number((el(id) as HTMLInputElement | HTMLSelectElement).value);

    /** Produsul indicilor din intervalul (a, b]. Simetric: invers = 1/factor. */
    function factor(a: number, b: number) {
      const [jos, sus] = a <= b ? [a, b] : [b, a];
      let f = 1;
      for (let i = 0; i < cfg.lant.length; i++) {
        const p = rPrim + i;
        if (p > jos && p <= sus) f *= cfg.lant[i] / 100;
      }
      return a <= b ? f : 1 / f;
    }

    function calculeaza(event?: Event) {
      event?.preventDefault();
      const suma = val('suma');
      const de = rang(val('an-de'), val('luna-de'));
      const la = rang(val('an-la'), val('luna-la'));
      const eroare = el('eroare')!;

      const inAfara = [de, la].some((r) => r < rPrim || r > rUltim);
      if (!Number.isFinite(suma) || suma < 0 || inAfara) {
        eroare.textContent = inAfara
          ? `Seria publicată de INS acoperă doar intervalul ${LUNI[cfg.primaLuna.luna - 1]} ${cfg.primaLuna.an} – ${LUNI[cfg.ultimaLuna.luna - 1]} ${cfg.ultimaLuna.an}.`
          : 'Scrie o sumă pozitivă.';
        eroare.hidden = false;
        return;
      }
      eroare.hidden = true;

      const f = factor(de, la);
      const vechiDe = de < rDenom, vechiLa = la < rDenom;
      const unitate = vechiDe && !vechiLa ? 1 / cfg.factorDenominare
        : !vechiDe && vechiLa ? cfg.factorDenominare : 1;
      const echivalent = suma * f * unitate;

      const monedaDe = vechiDe ? 'ROL' : 'RON';
      const monedaLa = vechiLa ? 'ROL' : 'RON';
      scrie('u-intrare', monedaDe);
      scrie('e-atunci', `${LUNI[val('luna-de') - 1]} ${val('an-de')}`);
      scrie('e-acum', `${LUNI[val('luna-la') - 1]} ${val('an-la')}`);
      scrie('r-atunci', `${lei(suma)} ${monedaDe}`);
      scrie('r-acum', `${lei(echivalent)} ${monedaLa}`);

      scrie('e-factor', f >= 1 ? 'Prețurile au crescut de' : 'Prețurile au scăzut cu');
      scrie('r-factor', f >= 1 ? `${lei(f, 2)} ori` : `${lei((1 - f) * 100, 1)}%`);
      scrie('r-cumulata', `${lei((f - 1) * 100, 1)}%`);

      const ani = Math.abs(la - de) / 12;
      scrie('d-putere', `${lei(100 / f, 1)}%`);
      scrie('d-medie', ani >= 1 ? `${lei((Math.pow(f, 1 / ani) - 1) * 100, 1)}%` : 'sub un an');

      (el('r-denominare') as HTMLElement).hidden = unitate === 1;
    }

    form.addEventListener('submit', calculeaza);
    for (const id of ['suma', 'an-de', 'luna-de', 'an-la', 'luna-la']) {
      el(id)?.addEventListener('change', calculeaza);
    }
  }
</script>
