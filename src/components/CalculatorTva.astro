---
// Calculator de TVA. Doua directii — adaugat si extras — pe aceeasi pereche de
// campuri, fiindca sunt aceeasi intrebare pusa din capete diferite.
import { COTE, COTA_STANDARD, adaugaTva, extrageTva, type Cota } from '@/lib/tva';

interface Props {
  suma?: number;
  cota?: Cota;
  directie?: 'adauga' | 'extrage';
  titlu?: string;
  nivel?: 'h1' | 'h2';
}
const {
  suma = 1000,
  cota = COTA_STANDARD,
  directie = 'adauga',
  titlu = 'Calculează TVA',
  nivel = 'h2',
} = Astro.props;

const r = directie === 'adauga' ? adaugaTva(suma, cota.procent) : extrageTva(suma, cota.procent);
const lei = (n: number, z = 2) =>
  n.toLocaleString('ro-RO', { minimumFractionDigits: z, maximumFractionDigits: z });
---

<section class="ct" aria-labelledby="ct-titlu">
  {nivel === 'h1' ? <h1 id="ct-titlu">{titlu}</h1> : <h2 id="ct-titlu">{titlu}</h2>}

  <form class="form" id="ct-form">
    <div class="camp">
      <label for="ct-suma">Suma</label>
      <div class="grup">
        <input id="ct-suma" type="number" inputmode="decimal" min="0" step="any" value={suma} required />
        <span class="unitate">lei</span>
      </div>
    </div>

    <div class="camp">
      <label for="ct-directie">Suma introdusă e</label>
      <select id="ct-directie">
        <option value="adauga" selected={directie === 'adauga'}>fără TVA (adaugă taxa)</option>
        <option value="extrage" selected={directie === 'extrage'}>cu TVA (extrage taxa)</option>
      </select>
    </div>

    <div class="camp">
      <label for="ct-cota">Cota</label>
      <select id="ct-cota">
        {COTE.map((c) => (
          <option value={c.procent} selected={c.procent === cota.procent}>
            {c.procent}%{c.inVigoare ? '' : ' (nu mai e în vigoare)'}
          </option>
        ))}
      </select>
    </div>

    <button type="submit">Calculează</button>
  </form>

  <output class="rezultat" for="ct-suma ct-directie ct-cota">
    <div class="col">
      <span class="eticheta">Fără TVA</span>
      <strong class="cifra cifre" id="ct-fara">{lei(r.faraTva)}</strong>
    </div>
    <div class="col col-tva">
      <span class="eticheta">TVA <span id="ct-procent">{r.procent}</span>%</span>
      <strong class="cifra cifre" id="ct-tva">{lei(r.tva)}</strong>
    </div>
    <div class="col col-total">
      <span class="eticheta">Cu TVA</span>
      <strong class="cifra cifre" id="ct-cu">{lei(r.cuTva)}</strong>
    </div>
  </output>

  <p class="sursa" id="ct-nota">
    Taxa se raportează la prețul fără TVA. Ca să o scoți dintr-un preț care o conține deja,
    se împarte la {100 + r.procent} și se înmulțește cu {r.procent} — nu se scad {r.procent}% din total.
  </p>
</section>

<style>
  .ct { background: var(--hartie-sus); border: 1px solid var(--linie); border-radius: var(--raza); padding: var(--sp-6); }
  .ct > :global(h1), .ct > :global(h2) { margin-top: 0; font-size: clamp(1.3rem, 2.6vw, 1.7rem); }

  .form { display: grid; gap: var(--sp-3); align-items: end; }
  @media (min-width: 52rem) { .form { grid-template-columns: 1fr 1.4fr 1fr auto; } }

  .camp { display: flex; flex-direction: column; gap: var(--sp-1); min-width: 0; }
  label { font-size: 0.8rem; font-weight: 600; color: var(--cerneala-slaba); }

  .grup { display: flex; border: 1px solid var(--linie-tare); border-radius: var(--raza); overflow: hidden; }
  .grup input { border: 0; }
  .unitate {
    display: flex; align-items: center; padding-inline: var(--sp-3);
    background: var(--hartie); border-left: 1px solid var(--linie);
    font-size: 0.8rem; font-weight: 600; color: var(--cerneala-slaba);
  }

  input, select {
    font: inherit; font-size: 1rem;
    padding: var(--sp-2) var(--sp-3); min-height: 2.75rem; width: 100%; min-width: 0;
    background: var(--hartie-sus); color: var(--cerneala);
    border: 1px solid var(--linie-tare); border-radius: var(--raza);
  }
  @media (min-width: 40rem) { input, select { font-size: 0.95rem; } }

  button {
    font: inherit; font-weight: 600; min-height: 2.75rem; padding-inline: var(--sp-6);
    border: 0; border-radius: var(--raza); background: var(--cerneala); color: var(--hartie-sus); cursor: pointer;
  }
  button:hover { opacity: 0.9; }

  .rezultat { display: grid; gap: var(--sp-3); margin-top: var(--sp-6); }
  @media (min-width: 40rem) { .rezultat { grid-template-columns: repeat(3, 1fr); } }
  .col { display: flex; flex-direction: column; gap: var(--sp-1); padding: var(--sp-4); border-radius: var(--raza); background: var(--hartie); }
  .col-tva { background: var(--acum-fundal); }
  .col-tva .cifra { color: var(--acum); }
  .col-total { background: var(--atunci-fundal); }
  .col-total .cifra { color: var(--atunci); }
  .eticheta { font-size: 0.75rem; }
  .cifra { font-size: clamp(1.3rem, 3.6vw, 1.8rem); font-family: var(--font-titlu); font-weight: 400; line-height: 1.1; }

  .sursa { margin-top: var(--sp-4); }
</style>

<script>
  import { adaugaTva, extrageTva } from '@/lib/tva';

  const form = document.getElementById('ct-form') as HTMLFormElement | null;
  if (form) {
    const lei = (n: number) =>
      n.toLocaleString('ro-RO', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const el = (id: string) => document.getElementById(id);
    const scrie = (id: string, t: string) => { const e = el(id); if (e) e.textContent = t; };

    function calculeaza(event?: Event) {
      event?.preventDefault();
      const suma = Math.max(0, Number((el('ct-suma') as HTMLInputElement).value));
      const procent = Number((el('ct-cota') as HTMLSelectElement).value);
      const adauga = (el('ct-directie') as HTMLSelectElement).value === 'adauga';
      const r = adauga ? adaugaTva(suma, procent) : extrageTva(suma, procent);

      scrie('ct-fara', lei(r.faraTva));
      scrie('ct-tva', lei(r.tva));
      scrie('ct-cu', lei(r.cuTva));
      scrie('ct-procent', String(procent));
      scrie('ct-nota',
        `Taxa se raportează la prețul fără TVA. Ca să o scoți dintr-un preț care o conține deja, `
        + `se împarte la ${100 + procent} și se înmulțește cu ${procent} — nu se scad ${procent}% din total.`);
    }

    form.addEventListener('submit', calculeaza);
    for (const id of ['ct-suma', 'ct-directie', 'ct-cota']) {
      el(id)?.addEventListener('change', calculeaza);
    }
  }
</script>
